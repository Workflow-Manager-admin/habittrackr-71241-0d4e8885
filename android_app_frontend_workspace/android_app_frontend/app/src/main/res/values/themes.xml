<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/habitulist_bg</item>
        <item name="android:windowBackground">@color/habitulist_bg</item>
        <item name="android:buttonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="android:editTextBackground">@drawable/rounded_edittext</item>
        <!-- Round corners globally for surfaces -->
        <item name="shapeAppearanceSmallComponent">@style/RoundedShape</item>
        <item name="shapeAppearanceMediumComponent">@style/RoundedShape</item>
        <item name="shapeAppearanceLargeComponent">@style/RoundedShape</item>
        <!-- Typography for minimal, clean look -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="RoundedShape" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
